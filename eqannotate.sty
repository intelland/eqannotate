\cs_new_protected:Npn \eqa_render:
  {
    \eqa_validate_annotations:
    \eqa_measure_labels:
    \prop_clear:N \l__eqa_lane_prop
    \dim_gzero:N \g__eqa_top_reserve_dim
    \dim_gzero:N \g__eqa_bottom_reserve_dim
    \tl_set:Nx \l__eqa_origin_tl {\eqa_origin_name:}
    \bool_set_false:N \l_tmpa_bool
    \seq_if_empty:NF \g__eqa_ids_seq {\bool_set_true:N \l_tmpa_bool}
    \seq_if_empty:NF \g__eqa_manual_ids_seq {\bool_set_true:N \l_tmpa_bool}
    \bool_if:NT \l_tmpa_bool
      {
        \begin{tikzpicture}[remember~picture,overlay]
          \eqa_extract_geometry:
          % Automatic labels keep the full solver. Manual labels bypass it but
          % still share the measured equation geometry and final render pass.
          \seq_if_empty:NF \g__eqa_ids_seq
            {
              \eqa_choose_sides:
              \eqa_sort_by_x:N \l__eqa_above_ids_seq
              \eqa_sort_by_x:N \l__eqa_below_ids_seq
              \eqa_prepare_label_bounds:
              \eqa_pack_seq:NN \l__eqa_above_ids_seq \l__eqa_above_lane_int
              \eqa_compute_lane_geometry:N \l__eqa_above_ids_seq
              \eqa_pack_seq:NN \l__eqa_below_ids_seq \l__eqa_below_lane_int
              \eqa_compute_lane_geometry:N \l__eqa_below_ids_seq
              \int_compare:nNnT {\l__eqa_above_lane_int} > {4}
                {\PackageWarning{eqannotate}{Dense~layout~uses~\int_use:N\l__eqa_above_lane_int~lanes~above~the~equation}}
              \int_compare:nNnT {\l__eqa_below_lane_int} > {4}
                {\PackageWarning{eqannotate}{Dense~layout~uses~\int_use:N\l__eqa_below_lane_int~lanes~below~the~equation}}
              \eqa_assign_route_tracks:N \l__eqa_above_ids_seq
              \seq_map_inline:Nn \l__eqa_above_ids_seq {\eqa_prepare_above:n{##1}}
              \eqa_assign_route_tracks:N \l__eqa_below_ids_seq
              \seq_map_inline:Nn \l__eqa_below_ids_seq {\eqa_prepare_below:n{##1}}
            }
          % All connector geometry must exist before any visible label is
          % drawn, so both automatic and manual labels can mask crossings.
          \seq_map_inline:Nn \g__eqa_manual_ids_seq {\eqa_prepare_manual:n{##1}}
          \seq_if_empty:NF \g__eqa_ids_seq
            {
              \seq_map_inline:Nn \l__eqa_above_ids_seq {\eqa_draw_connector_above:n{##1}}
              \seq_map_inline:Nn \l__eqa_below_ids_seq {\eqa_draw_connector_below:n{##1}}
            }
          \seq_map_inline:Nn \g__eqa_manual_ids_seq {\eqa_draw_manual_connector:n{##1}}
          \seq_if_empty:NF \g__eqa_ids_seq
            {
              \seq_map_inline:Nn \l__eqa_above_ids_seq {\eqa_draw_label_above:n{##1}}
              \seq_map_inline:Nn \l__eqa_below_ids_seq {\eqa_draw_label_below:n{##1}}
              \int_gset_eq:NN \g__eqa_above_used_int \l__eqa_above_lane_int
              \int_gset_eq:NN \g__eqa_below_used_int \l__eqa_below_lane_int
            }
          \seq_map_inline:Nn \g__eqa_manual_ids_seq {\eqa_draw_manual_label:n{##1}}
          \eqa_compute_reserve:
          \eqa_augment_manual_reserve:
        \end{tikzpicture}%
      }
    \eqa_write_reserve:
  }

% Manual escape hatch. The syntax stays intentionally close to raw TikZ:
% node options position the annotation relative to the marked target. Unlike
% the early prototype, manual annotations are collected and rendered in the
% same final overlay pass as automatic annotations. This lets them inherit
% themes/callout styles, stay behind the label mask, and contribute to the
% .aux-based vertical space reservation.
\NewDocumentCommand \eqannotatemanual { O{yshift=1cm} O{} m m }
  {
    \eqaIfAmsmathMeasuringTF
      {}
      {
        \bool_if:NTF \l__eqa_active_bool
          {
            \prop_if_in:NnT \g__eqa_manual_text_prop {#3}
              {
                \PackageWarning{eqannotate}
                  {Manual~annotation~id~`#3'~declared~more~than~once;~using~the~last~declaration}
              }
            \seq_if_in:NnF \g__eqa_manual_ids_seq {#3}
              {\seq_gput_right:Nn \g__eqa_manual_ids_seq {#3}}
            \prop_gput:Nnn \g__eqa_manual_opts_prop {#3}{#1}
            \prop_gput:Nnn \g__eqa_manual_route_prop {#3}{#2}
            \prop_gput:Nnn \g__eqa_manual_text_prop {#3}{#4}
          }
          {
            \PackageError{eqannotate}
              {\\eqannotatemanual~used~outside~an~EqAnnotate~display~environment}
              {Place~manual~annotations~inside~an~EqAnnotate~display~environment.}
          }
      }
  }

