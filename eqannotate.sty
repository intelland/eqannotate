    \dim_set:Nn \l__eqa_multline_phantom_ht_dim {\box_ht:N\l__eqa_measure_box}
    \dim_set:Nn \l__eqa_multline_phantom_dp_dim {\box_dp:N\l__eqa_measure_box}
    \bool_if:NTF \l__eqa_numbered_bool
      {
