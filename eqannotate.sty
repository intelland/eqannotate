\cs_new_protected:Npn \eqa_prepare_layout_dims:
  {
    % Evaluate all em-based settings in the surrounding document font.
    % tikzpicture itself uses \nullfont, where an em-based dimension can be 0pt.
    \dim_set:Nn \l__eqa_basegap_dim {\eqannotatebasegap}
    \dim_set:Nn \l__eqa_lanestep_dim {\eqannotatelanestep}
    \dim_set:Nn \l__eqa_lanegap_dim {\eqannotatelanegap}
    \dim_set:Nn \l__eqa_maxlabelwidth_dim {\eqannotatemaxlabelwidth}
    \dim_set:Nn \l__eqa_outerpad_dim {\eqannotateouterpad}
    \dim_set:Nn \l__eqa_hgap_dim {\eqannotatehgap}
    \dim_set:Nn \l__eqa_sidebias_dim {\eqannotatesidebias}
    \dim_set:Nn \l__eqa_labelgap_dim {\eqannotatelabelgap}
    \dim_set:Nn \l__eqa_columnpad_dim {\eqannotatecolumnpad}
    \dim_set:Nn \l__eqa_targetgap_dim {\eqannotatetargetgap}
    \dim_set:Nn \l__eqa_routetrackstep_dim {\eqannotateroutetrackstep}
    \dim_set:Nn \l__eqa_routetrackspan_dim {\eqannotateroutetrackspan}
    \dim_set:Nn \l__eqa_maxshift_dim {\eqannotatemaxshift}
    \dim_set:Nn \l__eqa_available_label_width_dim
      {\linewidth - 2\l__eqa_columnpad_dim}
    \dim_compare:nNnT {\l__eqa_available_label_width_dim} < {2em}
      {\dim_set:Nn \l__eqa_available_label_width_dim {2em}}
    % Text width excludes the 2pt TikZ inner xsep on both sides.
    \dim_set:Nn \l__eqa_wrap_content_width_dim
      {\l__eqa_available_label_width_dim - 4pt}
    \dim_compare:nNnT {\l__eqa_maxlabelwidth_dim} < {\l__eqa_wrap_content_width_dim}
      {\dim_set_eq:NN \l__eqa_wrap_content_width_dim \l__eqa_maxlabelwidth_dim}
    \dim_compare:nNnT {\l__eqa_wrap_content_width_dim} < {4em}
      {\dim_set:Nn \l__eqa_wrap_content_width_dim {4em}}
  }

\cs_new_protected:Npn \eqa_read_reserve:
  {
    \cs_if_exist:cTF {eqa@top@\int_use:N\l__eqa_equation_int}
      {
        \dim_set:Nn \l__eqa_previous_top_dim
          {\use:c{eqa@top@\int_use:N\l__eqa_equation_int}}
        \dim_set:Nn \l__eqa_previous_bottom_dim
          {\use:c{eqa@bottom@\int_use:N\l__eqa_equation_int}}
      }
      {
        \dim_set:Nn \l__eqa_previous_top_dim {\eqannotateinitialreserve}
        \dim_set:Nn \l__eqa_previous_bottom_dim {\eqannotateinitialreserve}
        \bool_if:NF \g__eqa_rerun_warned_bool
          {
            \PackageWarning{eqannotate}{Rerun~LaTeX~for~optimized~annotation~spacing}
            \bool_gset_true:N \g__eqa_rerun_warned_bool
          }
      }
  }

\cs_new_protected:Npn \eqa_validate_annotations:
  {
    % Manual declarations are validated first. If the same target is declared
    % through both interfaces, manual placement deliberately wins: it is the
    % escape hatch for cases where the automatic solver is not desired.
    \seq_clear:N \l__eqa_valid_manual_ids_seq
    \seq_map_inline:Nn \g__eqa_manual_ids_seq
      {
        \prop_if_in:NnTF \g__eqa_marked_prop {##1}
          {\seq_put_right:Nn \l__eqa_valid_manual_ids_seq {##1}}
          {
            \PackageWarning{eqannotate}
              {Manual~annotation~`##1'~has~no~matching~\\eqmark;~skipping~this~annotation}
          }
      }
    \seq_gset_eq:NN \g__eqa_manual_ids_seq \l__eqa_valid_manual_ids_seq

    \seq_clear:N \l__eqa_valid_ids_seq
    \seq_map_inline:Nn \g__eqa_ids_seq
      {
        \prop_if_in:NnTF \g__eqa_marked_prop {##1}
          {
            \seq_if_in:NnTF \g__eqa_manual_ids_seq {##1}
              {
                \PackageWarning{eqannotate}
                  {Target~`##1'~has~both~automatic~and~manual~annotations;~manual~placement~overrides~automatic~placement}
              }
              {\seq_put_right:Nn \l__eqa_valid_ids_seq {##1}}
          }
          {
            \PackageWarning{eqannotate}
              {Annotation~`##1'~has~no~matching~\\eqmark;~skipping~this~annotation}
          }
      }
    \seq_gset_eq:NN \g__eqa_ids_seq \l__eqa_valid_ids_seq
  }

\cs_new_protected:Npn \eqa_measure_labels:
  {
    \prop_clear:N \l__eqa_width_prop
    \prop_clear:N \l__eqa_height_prop
    \prop_clear:N \l__eqa_text_width_prop
    \seq_map_inline:Nn \g__eqa_ids_seq
      {
        \prop_get:NnN \g__eqa_text_prop {##1}\l__eqa_text_tl
        \hbox_set:Nn \l__eqa_measure_box
          {{\eqannotatefont\strut\l__eqa_text_tl}}
        % Keep short labels natural-width. Long labels become bounded
        % paragraphs *before* horizontal packing, so their wrapped height is
        % part of the layout rather than an after-the-fact rendering detail.
        \dim_set:Nn \l__eqa_label_width_dim
          {\box_wd:N\l__eqa_measure_box + 4pt}
        \dim_set:Nn \l__eqa_label_height_dim
          {\box_ht:N\l__eqa_measure_box + \box_dp:N\l__eqa_measure_box + 3pt}
        \dim_zero:N \l__eqa_label_text_width_dim
        \dim_compare:nNnT
          {\box_wd:N\l__eqa_measure_box} > {\l__eqa_wrap_content_width_dim}
          {
            \vbox_set:Nn \l__eqa_wrap_box
              {
                \hsize=\l__eqa_wrap_content_width_dim
                \parindent=0pt
                \centering
                \eqannotatefont
                \strut\l__eqa_text_tl\par
              }
            \dim_set_eq:NN \l__eqa_label_text_width_dim \l__eqa_wrap_content_width_dim
            \dim_set:Nn \l__eqa_label_width_dim
              {\l__eqa_wrap_content_width_dim + 4pt}
            \dim_set:Nn \l__eqa_label_height_dim
              {\box_ht:N\l__eqa_wrap_box + \box_dp:N\l__eqa_wrap_box + 3pt}
          }
        \prop_put:Nnx \l__eqa_width_prop {##1}
          {\dim_use:N\l__eqa_label_width_dim}
        \prop_put:Nnx \l__eqa_height_prop {##1}
          {\dim_use:N\l__eqa_label_height_dim}
        \prop_put:Nnx \l__eqa_text_width_prop {##1}
          {\dim_use:N\l__eqa_label_text_width_dim}
      }
  }

\cs_new_protected:Npn \eqa_mark_column_bounds:
  {
    % A zero-height full-\linewidth box gives two remembered nodes at the
    % active line/column edges without changing the displayed equation width.
    \par\nointerlineskip
    \hbox to \linewidth{%
      \tikzmarknode[inner~sep=0pt,outer~sep=0pt]{\eqa_column_left_name:}{\rule{0pt}{0pt}}%
      \hfil
      \tikzmarknode[inner~sep=0pt,outer~sep=0pt]{\eqa_column_right_name:}{\rule{0pt}{0pt}}%
    }%
    \par\nointerlineskip
  }

\cs_new_protected:Npn \eqa_extract_geometry:
  {
    \tl_set:Nx \l__eqa_origin_tl {\eqa_origin_name:}
    \pgfextractx{\l__eqa_column_left_dim}
      {\pgfpointanchor{\eqa_column_left_name:}{center}}
    \pgfextractx{\l__eqa_column_right_dim}
      {\pgfpointanchor{\eqa_column_right_name:}{center}}
    \dim_set:Nn \l__eqa_bound_left_dim
      {\l__eqa_column_left_dim + \l__eqa_columnpad_dim}
    \dim_set:Nn \l__eqa_bound_right_dim
      {\l__eqa_column_right_dim - \l__eqa_columnpad_dim}
    \bool_if:NTF \l__eqa_multline_bool
      {
        \pgfextracty{\l__eqa_multline_top_y_dim}
          {\pgfpointanchor{\eqa_multline_top_name:}{center}}
        \pgfextracty{\l__eqa_multline_bottom_y_dim}
          {\pgfpointanchor{\eqa_multline_bottom_name:}{center}}
        \dim_set:Nn \l__eqa_multline_center_y_dim
          {.5\l__eqa_multline_top_y_dim + .5\l__eqa_multline_bottom_y_dim}
        \dim_set:Nn \l__eqa_origin_north_y_dim
          {\l__eqa_multline_center_y_dim + \l__eqa_multline_phantom_ht_dim}
        \dim_set:Nn \l__eqa_origin_south_y_dim
          {\l__eqa_multline_center_y_dim - \l__eqa_multline_phantom_dp_dim}
      }
      {
        \pgfextracty{\l__eqa_origin_north_y_dim}
          {\pgfpointanchor{\l__eqa_origin_tl}{north}}
        \pgfextracty{\l__eqa_origin_south_y_dim}
          {\pgfpointanchor{\l__eqa_origin_tl}{south}}
      }
    \seq_map_inline:Nn \g__eqa_ids_seq
      {
        \tl_set:Nx \l__eqa_physical_tl {\eqa_physical_name:n{##1}}
        \pgfextractx{\l__eqa_target_x_dim}
          {\pgfpointanchor{\l__eqa_physical_tl}{center}}
        \pgfextracty{\l__eqa_target_north_y_dim}
          {\pgfpointanchor{\l__eqa_physical_tl}{north}}
        \pgfextracty{\l__eqa_target_south_y_dim}
          {\pgfpointanchor{\l__eqa_physical_tl}{south}}
        \prop_put:Nnx \l__eqa_x_prop {##1}
          {\dim_use:N\l__eqa_target_x_dim}
        \prop_put:Nnx \l__eqa_north_y_prop {##1}
          {\dim_use:N\l__eqa_target_north_y_dim}
        \prop_put:Nnx \l__eqa_south_y_prop {##1}
          {\dim_use:N\l__eqa_target_south_y_dim}
        \bool_if:NT \l__eqa_multline_bool
          {
            \dim_compare:nNnT {\l__eqa_target_north_y_dim} > {\l__eqa_origin_north_y_dim}
              {\dim_set_eq:NN \l__eqa_origin_north_y_dim \l__eqa_target_north_y_dim}
            \dim_compare:nNnT {\l__eqa_target_south_y_dim} < {\l__eqa_origin_south_y_dim}
              {\dim_set_eq:NN \l__eqa_origin_south_y_dim \l__eqa_target_south_y_dim}
          }
      }
  }

\cs_new_protected:Npn \eqa_push_above:n #1
  {
    \seq_put_right:Nn \l__eqa_above_ids_seq {#1}
    \int_incr:N \l__eqa_above_item_int
  }
\cs_new_protected:Npn \eqa_push_below:n #1
  {
    \seq_put_right:Nn \l__eqa_below_ids_seq {#1}
    \int_incr:N \l__eqa_below_item_int
  }

\cs_new_protected:Npn \eqa_choose_auto_side:n #1
  {
    \prop_get:NnN \l__eqa_north_y_prop {#1}\l__eqa_tmpa_tl
    \prop_get:NnN \l__eqa_south_y_prop {#1}\l__eqa_tmpb_tl
    \dim_set:Nn \l__eqa_target_north_y_dim {\l__eqa_tmpa_tl}
    \dim_set:Nn \l__eqa_target_south_y_dim {\l__eqa_tmpb_tl}
    \dim_set:Nn \l__eqa_escape_above_dim
      {\l__eqa_origin_north_y_dim - \l__eqa_target_north_y_dim}
    \dim_set:Nn \l__eqa_escape_below_dim
      {\l__eqa_target_south_y_dim - \l__eqa_origin_south_y_dim}
    \dim_compare:nNnT {\l__eqa_escape_above_dim} < {0pt}
      {\dim_zero:N\l__eqa_escape_above_dim}
    \dim_compare:nNnT {\l__eqa_escape_below_dim} < {0pt}
      {\dim_zero:N\l__eqa_escape_below_dim}
    % If one edge is clearly nearer, use it. Otherwise balance both bands.
    \dim_set:Nn \l__eqa_lane_threshold_dim
      {\l__eqa_escape_above_dim + \l__eqa_sidebias_dim}
    \dim_compare:nNnTF {\l__eqa_lane_threshold_dim} < {\l__eqa_escape_below_dim}
      {\eqa_push_above:n{#1}}
      {
        \dim_set:Nn \l__eqa_lane_threshold_dim
          {\l__eqa_escape_below_dim + \l__eqa_sidebias_dim}
        \dim_compare:nNnTF {\l__eqa_lane_threshold_dim} < {\l__eqa_escape_above_dim}
          {\eqa_push_below:n{#1}}
          {
            \int_compare:nNnTF {\l__eqa_above_item_int} < {\l__eqa_below_item_int + 1}
              {\eqa_push_above:n{#1}}
              {\eqa_push_below:n{#1}}
          }
      }
  }

\cs_new_protected:Npn \eqa_choose_sides:
  {
    \seq_clear:N \l__eqa_above_ids_seq
    \seq_clear:N \l__eqa_below_ids_seq
    \int_zero:N \l__eqa_above_item_int
    \int_zero:N \l__eqa_below_item_int
    \seq_map_inline:Nn \g__eqa_ids_seq
      {
        \prop_get:NnN \g__eqa_prefer_prop {##1}\l__eqa_prefer_tl
        \str_case:VnF \l__eqa_prefer_tl
          {
            {above}{\eqa_push_above:n{##1}}
            {below}{\eqa_push_below:n{##1}}
          }
          {\eqa_choose_auto_side:n{##1}}
      }
  }

\cs_new_protected:Npn \eqa_prepare_label_bounds:n #1
  {
    \prop_get:NnN \l__eqa_x_prop {#1}\l__eqa_tmpa_tl
    \prop_get:NnN \l__eqa_width_prop {#1}\l__eqa_tmpb_tl
    \dim_set:Nn \l__eqa_target_x_dim {\l__eqa_tmpa_tl}
    \dim_set:Nn \l__eqa_label_width_dim {\l__eqa_tmpb_tl}
    \dim_set:Nn \l__eqa_halfwidth_dim {.5\l__eqa_label_width_dim}
    \dim_set:Nn \l__eqa_min_center_dim
      {\l__eqa_bound_left_dim + \l__eqa_halfwidth_dim}
    \dim_set:Nn \l__eqa_max_center_dim
      {\l__eqa_bound_right_dim - \l__eqa_halfwidth_dim}
    % Limit automatic horizontal motion as well as keeping the label inside
    % the active column. This keeps de-overlap useful without allowing a
    % label to drift arbitrarily far from its term.
    \dim_set:Nn \l__eqa_feasible_center_dim
      {\l__eqa_target_x_dim - \l__eqa_maxshift_dim}
    \dim_compare:nNnT {\l__eqa_feasible_center_dim} > {\l__eqa_min_center_dim}
      {\dim_set_eq:NN \l__eqa_min_center_dim \l__eqa_feasible_center_dim}
    \dim_set:Nn \l__eqa_feasible_center_dim
      {\l__eqa_target_x_dim + \l__eqa_maxshift_dim}
    \dim_compare:nNnT {\l__eqa_feasible_center_dim} < {\l__eqa_max_center_dim}
      {\dim_set_eq:NN \l__eqa_max_center_dim \l__eqa_feasible_center_dim}
    % A label wider than the usable column has no legal interval. Keep it
    % centered rather than letting the solver recurse on an invalid range.
    \dim_compare:nNnTF {\l__eqa_min_center_dim} > {\l__eqa_max_center_dim}
      {
        \dim_set:Nn \l__eqa_label_x_dim
          {.5\l__eqa_bound_left_dim + .5\l__eqa_bound_right_dim}
        \dim_set_eq:NN \l__eqa_min_center_dim \l__eqa_label_x_dim
        \dim_set_eq:NN \l__eqa_max_center_dim \l__eqa_label_x_dim
      }
      {
        \dim_set_eq:NN \l__eqa_label_x_dim \l__eqa_target_x_dim
        \dim_compare:nNnT {\l__eqa_label_x_dim} < {\l__eqa_min_center_dim}
          {\dim_set_eq:NN \l__eqa_label_x_dim \l__eqa_min_center_dim}
        \dim_compare:nNnT {\l__eqa_label_x_dim} > {\l__eqa_max_center_dim}
          {\dim_set_eq:NN \l__eqa_label_x_dim \l__eqa_max_center_dim}
      }
    \prop_put:Nnx \l__eqa_min_center_prop {#1}
      {\dim_use:N\l__eqa_min_center_dim}
    \prop_put:Nnx \l__eqa_max_center_prop {#1}
      {\dim_use:N\l__eqa_max_center_dim}
    \prop_put:Nnx \l__eqa_label_x_prop {#1}
      {\dim_use:N\l__eqa_label_x_dim}
  }

\cs_new_protected:Npn \eqa_prepare_label_bounds:
  {
    \prop_clear:N \l__eqa_label_x_prop
    \prop_clear:N \l__eqa_min_center_prop
    \prop_clear:N \l__eqa_max_center_prop
    \prop_clear:N \l__eqa_earliest_center_prop
    \prop_clear:N \l__eqa_track_prop
    \seq_map_inline:Nn \l__eqa_above_ids_seq {\eqa_prepare_label_bounds:n{##1}}
    \seq_map_inline:Nn \l__eqa_below_ids_seq {\eqa_prepare_label_bounds:n{##1}}
  }

\cs_new_protected:Npn \eqa_sort_by_x:N #1
  {
    \seq_sort:Nn #1
      {
        \prop_get:NnN \l__eqa_x_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_x_prop {##2}\l__eqa_tmpb_tl
        \dim_compare:nNnTF {\l__eqa_tmpa_tl} > {\l__eqa_tmpb_tl}
          {\sort_return_swapped:}
          {\sort_return_same:}
      }
  }

\cs_new_protected:Npn \eqa_commit_deoverlap_lane:
  {
    \int_set_eq:NN \l__eqa_current_lane_int \l__eqa_candidate_lane_int
    \prop_put:NVx \l__eqa_lane_prop \l__eqa_current_id_tl
      {\int_use:N\l__eqa_current_lane_int}
    \prop_put:NVx \l__eqa_earliest_center_prop \l__eqa_current_id_tl
      {\dim_use:N\l__eqa_feasible_center_dim}
    \dim_set:Nn \l__eqa_interval_right_dim
      {\l__eqa_feasible_center_dim + \l__eqa_halfwidth_dim}
    \prop_put:Nxx \l__eqa_lane_right_prop
      {\int_use:N\l__eqa_current_lane_int}
      {\dim_use:N\l__eqa_interval_right_dim}
  }

\cs_new_protected:Npn \eqa_find_deoverlap_lane:
  {
    \int_compare:nNnTF {\l__eqa_candidate_lane_int} > {\l__eqa_lane_count_int}
      {
        \int_incr:N \l__eqa_lane_count_int
        \int_set_eq:NN \l__eqa_candidate_lane_int \l__eqa_lane_count_int
        \prop_get:NVN \l__eqa_min_center_prop
          \l__eqa_current_id_tl \l__eqa_tmpa_tl
        \dim_set:Nn \l__eqa_feasible_center_dim {\l__eqa_tmpa_tl}
        \eqa_commit_deoverlap_lane:
      }
      {
        \prop_get:NxN \l__eqa_lane_right_prop
          {\int_use:N\l__eqa_candidate_lane_int}\l__eqa_tmpa_tl
        \dim_set:Nn \l__eqa_lane_right_dim {\l__eqa_tmpa_tl}
        \prop_get:NVN \l__eqa_min_center_prop
          \l__eqa_current_id_tl \l__eqa_tmpa_tl
        \prop_get:NVN \l__eqa_max_center_prop
          \l__eqa_current_id_tl \l__eqa_tmpb_tl
        \dim_set:Nn \l__eqa_min_center_dim {\l__eqa_tmpa_tl}
        \dim_set:Nn \l__eqa_max_center_dim {\l__eqa_tmpb_tl}
        \dim_set:Nn \l__eqa_feasible_center_dim
          {\l__eqa_lane_right_dim + \l__eqa_hgap_dim + \l__eqa_halfwidth_dim}
        \dim_compare:nNnT {\l__eqa_feasible_center_dim} < {\l__eqa_min_center_dim}
          {\dim_set_eq:NN \l__eqa_feasible_center_dim \l__eqa_min_center_dim}
        \dim_compare:nNnTF
          {\l__eqa_feasible_center_dim} > {\l__eqa_max_center_dim}
          {
            \int_incr:N \l__eqa_candidate_lane_int
            \eqa_find_deoverlap_lane:
          }
          {\eqa_commit_deoverlap_lane:}
      }
  }

\cs_new_protected:Npn \eqa_relax_seq_global:N #1
  {
    % Relax all lanes in one right-to-left pass. A global center bound keeps
    % label order consistent with target order even across different lanes;
    % per-lane right bounds simultaneously preserve collision spacing.
    \prop_clear:N \l__eqa_lane_next_left_prop
    \int_step_inline:nn {\l__eqa_lane_count_int}
      {
        \prop_put:Nnx \l__eqa_lane_next_left_prop {##1}
          {\dim_use:N\l__eqa_bound_right_dim}
      }
    \dim_set_eq:NN \l__eqa_next_global_center_dim \l__eqa_bound_right_dim
    \seq_set_eq:NN \l__eqa_reverse_seq #1
    \seq_reverse:N \l__eqa_reverse_seq
    \seq_map_inline:Nn \l__eqa_reverse_seq
      {
        \prop_get:NnN \l__eqa_lane_prop {##1}\l__eqa_tmpa_tl
        \int_set:Nn \l__eqa_current_lane_int {\l__eqa_tmpa_tl}
        \prop_get:NnN \l__eqa_width_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_x_prop {##1}\l__eqa_tmpb_tl
        \dim_set:Nn \l__eqa_label_width_dim {\l__eqa_tmpa_tl}
        \dim_set:Nn \l__eqa_halfwidth_dim {.5\l__eqa_label_width_dim}
        \dim_set:Nn \l__eqa_target_x_dim {\l__eqa_tmpb_tl}
        \prop_get:NnN \l__eqa_min_center_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_max_center_prop {##1}\l__eqa_tmpb_tl
        \dim_set:Nn \l__eqa_min_center_dim {\l__eqa_tmpa_tl}
        \dim_set:Nn \l__eqa_max_center_dim {\l__eqa_tmpb_tl}
        \prop_get:NnN \l__eqa_earliest_center_prop {##1}\l__eqa_tmpa_tl
        \dim_set:Nn \l__eqa_feasible_center_dim {\l__eqa_tmpa_tl}
        \prop_get:NxN \l__eqa_lane_next_left_prop
          {\int_use:N\l__eqa_current_lane_int}\l__eqa_tmpa_tl
        \dim_set:Nn \l__eqa_next_left_dim {\l__eqa_tmpa_tl}
        \dim_set:Nn \l__eqa_allowed_right_dim
          {\l__eqa_next_left_dim - \l__eqa_hgap_dim - \l__eqa_halfwidth_dim}
        \dim_compare:nNnT {\l__eqa_allowed_right_dim} > {\l__eqa_max_center_dim}
          {\dim_set_eq:NN \l__eqa_allowed_right_dim \l__eqa_max_center_dim}
        \dim_compare:nNnT {\l__eqa_allowed_right_dim} > {\l__eqa_next_global_center_dim}
          {\dim_set_eq:NN \l__eqa_allowed_right_dim \l__eqa_next_global_center_dim}
        \dim_set_eq:NN \l__eqa_desired_center_dim \l__eqa_target_x_dim
        \dim_compare:nNnT {\l__eqa_desired_center_dim} < {\l__eqa_min_center_dim}
          {\dim_set_eq:NN \l__eqa_desired_center_dim \l__eqa_min_center_dim}
        \dim_compare:nNnT {\l__eqa_desired_center_dim} > {\l__eqa_allowed_right_dim}
          {\dim_set_eq:NN \l__eqa_desired_center_dim \l__eqa_allowed_right_dim}
        \dim_set_eq:NN \l__eqa_label_x_dim \l__eqa_desired_center_dim
        \dim_compare:nNnT {\l__eqa_label_x_dim} < {\l__eqa_feasible_center_dim}
          {\dim_set_eq:NN \l__eqa_label_x_dim \l__eqa_feasible_center_dim}
        \dim_compare:nNnT {\l__eqa_label_x_dim} > {\l__eqa_allowed_right_dim}
          {
            % If global order and bounded/collision-free placement cannot all
            % be satisfied, keep the collision-free lane solution silently.
            % Routing micro-tracks still separate the resulting connectors.
            \dim_set_eq:NN \l__eqa_label_x_dim \l__eqa_feasible_center_dim
          }
        \prop_put:Nnx \l__eqa_label_x_prop {##1}
          {\dim_use:N\l__eqa_label_x_dim}
        \dim_set:Nn \l__eqa_next_left_dim
          {\l__eqa_label_x_dim - \l__eqa_halfwidth_dim}
        \prop_put:Nxx \l__eqa_lane_next_left_prop
          {\int_use:N\l__eqa_current_lane_int}
          {\dim_use:N\l__eqa_next_left_dim}
        \dim_set_eq:NN \l__eqa_next_global_center_dim \l__eqa_label_x_dim
      }
  }

\cs_new_protected:Npn \eqa_pack_seq:NN #1#2
  {
    \prop_clear:N \l__eqa_lane_right_prop
    \int_zero:N \l__eqa_lane_count_int
    \seq_map_inline:Nn #1
      {
        \tl_set:Nn \l__eqa_current_id_tl {##1}
        \prop_get:NnN \l__eqa_width_prop {##1}\l__eqa_tmpa_tl
        \dim_set:Nn \l__eqa_label_width_dim {\l__eqa_tmpa_tl}
        \dim_set:Nn \l__eqa_halfwidth_dim {.5\l__eqa_label_width_dim}
        \int_set:Nn \l__eqa_candidate_lane_int {1}
        \eqa_find_deoverlap_lane:
      }
    \eqa_relax_seq_global:N #1
    \int_set_eq:NN #2 \l__eqa_lane_count_int
  }

\cs_new_protected:Npn \eqa_compute_lane_geometry:N #1
  {
    % Wrapped labels can be taller than one line. Each lane advances by the
    % greater of the historical lane step and (actual lane height + gap).
    \prop_clear:N \l__eqa_lane_height_prop
    \prop_clear:N \l__eqa_lane_offset_prop
    \seq_map_inline:Nn #1
      {
        \prop_get:NnN \l__eqa_lane_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_height_prop {##1}\l__eqa_tmpb_tl
        \prop_get:NxNTF \l__eqa_lane_height_prop {\l__eqa_tmpa_tl}\l__eqa_text_tl
          {
            \dim_set:Nn \l__eqa_lane_height_dim {\l__eqa_text_tl}
            \dim_compare:nNnT {\l__eqa_tmpb_tl} > {\l__eqa_lane_height_dim}
              {\prop_put:Nxx \l__eqa_lane_height_prop {\l__eqa_tmpa_tl}{\l__eqa_tmpb_tl}}
          }
          {\prop_put:Nxx \l__eqa_lane_height_prop {\l__eqa_tmpa_tl}{\l__eqa_tmpb_tl}}
      }
    \dim_set_eq:NN \l__eqa_lane_offset_dim \l__eqa_basegap_dim
    \int_step_inline:nn {\l__eqa_lane_count_int}
      {
        \prop_put:Nnx \l__eqa_lane_offset_prop {##1}
          {\dim_use:N\l__eqa_lane_offset_dim}
        \prop_get:NxN \l__eqa_lane_height_prop {##1}\l__eqa_tmpa_tl
        \dim_set:Nn \l__eqa_lane_height_dim {\l__eqa_tmpa_tl}
        \dim_set:Nn \l__eqa_lane_advance_dim
          {\l__eqa_lane_height_dim + \l__eqa_lanegap_dim}
        \dim_compare:nNnT {\l__eqa_lane_advance_dim} < {\l__eqa_lanestep_dim}
          {\dim_set_eq:NN \l__eqa_lane_advance_dim \l__eqa_lanestep_dim}
        \dim_add:Nn \l__eqa_lane_offset_dim {\l__eqa_lane_advance_dim}
      }
    \seq_map_inline:Nn #1
      {
        \prop_get:NnN \l__eqa_lane_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NxN \l__eqa_lane_offset_prop {\l__eqa_tmpa_tl}\l__eqa_tmpb_tl
        \prop_put:Nnx \l__eqa_yshift_prop {##1}{\l__eqa_tmpb_tl}
      }
  }

\cs_new_protected:Npn \eqa_assign_route_tracks:N #1
  {
    % Give displaced connectors separate micro-tracks. The longest horizontal
    % moves are routed closest to the formula, so their horizontal segments
    % pass below the shorter label stems rather than crossing through them.
    % This is a compact orthogonal equivalent of interval nesting.
    \prop_clear:N \l__eqa_track_prop
    \seq_set_eq:NN \l__eqa_route_ids_seq #1
    \seq_sort:Nn \l__eqa_route_ids_seq
      {
        \prop_get:NnN \l__eqa_label_x_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_x_prop {##1}\l__eqa_tmpb_tl
        \dim_set:Nn \l__eqa_shift_a_dim {\l__eqa_tmpa_tl-\l__eqa_tmpb_tl}
        \dim_compare:nNnT {\l__eqa_shift_a_dim} < {0pt}
          {\dim_set:Nn \l__eqa_shift_a_dim {-\l__eqa_shift_a_dim}}
        \prop_get:NnN \l__eqa_label_x_prop {##2}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_x_prop {##2}\l__eqa_tmpb_tl
        \dim_set:Nn \l__eqa_shift_b_dim {\l__eqa_tmpa_tl-\l__eqa_tmpb_tl}
        \dim_compare:nNnT {\l__eqa_shift_b_dim} < {0pt}
          {\dim_set:Nn \l__eqa_shift_b_dim {-\l__eqa_shift_b_dim}}
        \dim_compare:nNnTF {\l__eqa_shift_a_dim} < {\l__eqa_shift_b_dim}
          {\sort_return_swapped:}
          {\sort_return_same:}
      }
    \int_zero:N \l__eqa_track_int
    \int_set:Nn \l__eqa_track_count_int {\seq_count:N \l__eqa_route_ids_seq}
    \dim_set_eq:NN \l__eqa_effective_trackstep_dim \l__eqa_routetrackstep_dim
    \int_compare:nNnT {\l__eqa_track_count_int} > {1}
      {
        \dim_set:Nn \l__eqa_routeoffset_dim
          {\l__eqa_routetrackspan_dim / \int_eval:n{\l__eqa_track_count_int-1}}
        \dim_compare:nNnT
          {\l__eqa_effective_trackstep_dim} > {\l__eqa_routeoffset_dim}
          {\dim_set_eq:NN \l__eqa_effective_trackstep_dim \l__eqa_routeoffset_dim}
      }
    \seq_map_inline:Nn \l__eqa_route_ids_seq
      {
        \int_incr:N \l__eqa_track_int
        \prop_put:Nnx \l__eqa_track_prop {##1}
          {\int_use:N\l__eqa_track_int}
      }
  }

\cs_new_protected:Npn \eqa_route_offset:n #1
  {
    \prop_get:NnN \l__eqa_track_prop {#1}\l__eqa_tmpa_tl
    \int_set:Nn \l__eqa_track_int {\l__eqa_tmpa_tl}
    % Center the bundle of micro-tracks around the historical corridor.
    % Formula: (i - (N+1)/2) * step, expressed without floating point.
    \dim_set:Nn \l__eqa_routeoffset_dim
      { \fp_eval:n
          { \l__eqa_track_int - ( \l__eqa_track_count_int + 1 ) / 2 }
        \l__eqa_effective_trackstep_dim }
  }

