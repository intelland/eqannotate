\cs_new_protected:Npn \eqa_augment_manual_reserve:
  {
    \seq_map_inline:Nn \g__eqa_manual_ids_seq
      {
        \pgfextracty{\l__eqa_manual_north_y_dim}
          {\pgfpointanchor{\eqa_manual_probe_name:n{##1}}{north}}
        \pgfextracty{\l__eqa_manual_south_y_dim}
          {\pgfpointanchor{\eqa_manual_probe_name:n{##1}}{south}}
        \dim_set:Nn \l__eqa_manual_extent_dim
          {\l__eqa_manual_north_y_dim - \l__eqa_origin_north_y_dim + \l__eqa_outerpad_dim}
        \dim_compare:nNnT {\l__eqa_manual_extent_dim} > {\l__eqa_top_reserve_dim}
          {\dim_set_eq:NN \l__eqa_top_reserve_dim \l__eqa_manual_extent_dim}
        \dim_set:Nn \l__eqa_manual_extent_dim
          {\l__eqa_origin_south_y_dim - \l__eqa_manual_south_y_dim + \l__eqa_outerpad_dim}
        \dim_compare:nNnT {\l__eqa_manual_extent_dim} > {\l__eqa_bottom_reserve_dim}
          {\dim_set_eq:NN \l__eqa_bottom_reserve_dim \l__eqa_manual_extent_dim}
      }
    \dim_gset_eq:NN \g__eqa_top_reserve_dim \l__eqa_top_reserve_dim
    \dim_gset_eq:NN \g__eqa_bottom_reserve_dim \l__eqa_bottom_reserve_dim
  }

