\cs_new_protected:Npn \eqa_draw_connector:nnnnn #1#2#3#4#5
  {
    % Leaders are rendered before labels. The later label node carries an
    % invisible page-colored mask, so any leader segment that would pass
    % under annotation text disappears automatically rather than mixing with
    % the glyphs.
    \str_if_eq:VnTF \g__eqa_callout_style_tl {arrow}
      {
        \draw[eqannotate/leader,draw=#4,
          shorten~<=\dim_use:N\l__eqa_labelgap_dim]
          (#1)--(#1|-#3)--(#2|-#3)--(#2);
        \str_if_eq:nnTF {#5}{above}
          {
            \fill[draw=#4,fill=#4]
              (#2)--([xshift=-.48mm,yshift=.92mm]#2)--
              ([xshift=.48mm,yshift=.92mm]#2)--cycle;
          }
          {
            \fill[draw=#4,fill=#4]
              (#2)--([xshift=-.48mm,yshift=-.92mm]#2)--
              ([xshift=.48mm,yshift=-.92mm]#2)--cycle;
          }
      }
      {
        \draw[eqannotate/leader,draw=#4,
          shorten~<=\dim_use:N\l__eqa_labelgap_dim,shorten~>=.8pt]
          (#1)--(#1|-#3)--(#2|-#3)--(#2);
      }
  }

