\cs_new_protected:Npn \eqa_render_mark_content:nn #1#2
  {
    \str_case:VnF \g__eqa_color_theme_tl
      {
        {colorful}{\eqannotatemathcolorbox{#1!\eqannotateshade}{#2}}
        {mono}{\mathstrut #2}
      }
      {\mathstrut #2}
  }

\NewDocumentCommand \eqmark { O{yellow} m m }
  {
    \eqaIfAmsmathMeasuringTF
      {\eqa_render_mark_content:nn {#1}{#3}}
      {
        \bool_if:NTF \l__eqa_active_bool
          {
            \prop_if_in:NnTF \g__eqa_marked_prop {#2}
              {
                \PackageWarning{eqannotate}
                  {Duplicate~mark~id~`#2'~in~one~annotated~equation;~using~the~first~target}
                \eqa_render_mark_content:nn {#1}{#3}
              }
              {
                \prop_gput:Nnn \g__eqa_marked_prop {#2}{1}
                \prop_gput:Nnn \g__eqa_color_prop {#2}{#1}
                \int_gincr:N \l__eqa_mark_int
                \prop_gput:Nnx \g__eqa_physical_prop {#2}
                  {eqa-\int_use:N\l__eqa_equation_int-m\int_use:N\l__eqa_mark_int}
                \tikzmarknode{\eqa_physical_name:n{#2}}
                  {\eqa_render_mark_content:nn {#1}{#3}}
              }
          }
          {
            \PackageError{eqannotate}
              {\\eqmark~used~outside~an~EqAnnotate~display~environment}
              {Place~marked~terms~inside~an~EqAnnotate~display~environment.}
            #3
          }
      }
  }

\NewDocumentCommand \eqannotate { O{} m m }
  {
    \eqaIfAmsmathMeasuringTF
      {}
      {
        \bool_if:NTF \l__eqa_active_bool
          {
            \keys_set:nn {eqa/note}{prefer=auto,#1}
            \prop_if_in:NnT \g__eqa_text_prop {#2}
              {
                \PackageWarning{eqannotate}
                  {Annotation~id~`#2'~declared~more~than~once;~using~the~last~declaration}
              }
            \seq_if_in:NnF \g__eqa_ids_seq {#2}
              {\seq_gput_right:Nn \g__eqa_ids_seq {#2}}
            \prop_gput:Nnn \g__eqa_text_prop {#2}{#3}
            \prop_gput:NnV \g__eqa_prefer_prop {#2}\l__eqa_prefer_tl
          }
          {
            \PackageError{eqannotate}
              {\\eqannotate~used~outside~an~EqAnnotate~display~environment}
              {Place~annotation~declarations~inside~an~EqAnnotate~display~environment.}
          }
      }
  }

% Commands used only while creating the invisible full-equation strut.
% The mark replacement must preserve the *visual vertical extent* of the
% active theme. In colorful mode the colorbox is taller/deeper than the raw
% glyph; ignoring that extent can place the routing corridor inside the box
% and make a final leader segment run in the wrong vertical direction.
\NewDocumentCommand \eqa_extent_mark { O{yellow} m m }
  {
    \str_if_eq:VnTF \g__eqa_color_theme_tl {colorful}
      {\eqannotatemathcolorbox{#1!\eqannotateshade}{#3}}
      {\mathstrut #3}
  }
\NewDocumentCommand \eqa_plain_note { O{} m m } {}
\NewDocumentCommand \eqa_plain_manual { O{} O{} m m } {}
