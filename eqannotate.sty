\cs_new_protected:Npn \eqa_compute_reserve:
  {
    \dim_zero:N \l__eqa_top_reserve_dim
    \dim_zero:N \l__eqa_bottom_reserve_dim
    \seq_map_inline:Nn \l__eqa_above_ids_seq
      {
        \prop_get:NnN \l__eqa_yshift_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_height_prop {##1}\l__eqa_tmpb_tl
        \dim_set:Nn \l__eqa_lane_offset_dim
          {\l__eqa_tmpa_tl + \l__eqa_tmpb_tl + \l__eqa_outerpad_dim}
        \dim_compare:nNnT {\l__eqa_lane_offset_dim} > {\l__eqa_top_reserve_dim}
          {\dim_set_eq:NN \l__eqa_top_reserve_dim \l__eqa_lane_offset_dim}
      }
    \seq_map_inline:Nn \l__eqa_below_ids_seq
      {
        \prop_get:NnN \l__eqa_yshift_prop {##1}\l__eqa_tmpa_tl
        \prop_get:NnN \l__eqa_height_prop {##1}\l__eqa_tmpb_tl
        \dim_set:Nn \l__eqa_lane_offset_dim
          {\l__eqa_tmpa_tl + \l__eqa_tmpb_tl + \l__eqa_outerpad_dim}
        \dim_compare:nNnT {\l__eqa_lane_offset_dim} > {\l__eqa_bottom_reserve_dim}
          {\dim_set_eq:NN \l__eqa_bottom_reserve_dim \l__eqa_lane_offset_dim}
      }
    \dim_gset_eq:NN \g__eqa_top_reserve_dim \l__eqa_top_reserve_dim
    \dim_gset_eq:NN \g__eqa_bottom_reserve_dim \l__eqa_bottom_reserve_dim
  }

