          \eqaIfAmsmathMeasuringTF
            {\mathstrut}
            {\tikzmarknode[inner~sep=0pt,outer~sep=0pt]
              {\eqa_multline_top_name:}{\mathstrut}}%
          #1%
          \eqaIfAmsmathMeasuringTF
            {}
            {\tikzmarknode[inner~sep=0pt,outer~sep=0pt]
              {\eqa_multline_bottom_name:}{\mathstrut}}%
        \end{multline}
      }
      {
        \begin{multline*}
          \eqaIfAmsmathMeasuringTF
            {\mathstrut}
