% eqannotate.sty -- declarative, self-layouting equation annotations
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{eqannotate}[2026/08/27 v0.1.0 Declarative equation annotations with automatic layout]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{expl3}
\RequirePackage{amsmath}
\usetikzlibrary{tikzmark,arrows.meta,calc}
\newcounter{eqannotateenv}% internal, checkpointed by \include/\includeonly

% Public style/layout knobs. The default API intentionally avoids exposing
% continuous coordinates; these are document-wide tuning parameters.
\newcommand\eqannotatefont{\sffamily\footnotesize}
\newcommand\eqannotateshade{20}
\newcommand\eqannotatebasegap{1.45em}
\newcommand\eqannotatelanestep{1.85em}
\newcommand\eqannotatelanegap{0.50em}
\newcommand\eqannotatemaxlabelwidth{.42\linewidth}
\newcommand\eqannotateouterpad{0.35em}
\newcommand\eqannotatehgap{0.65em}
\newcommand\eqannotatesidebias{0.45em}
\newcommand\eqannotateinitialreserve{4.2em}
\newcommand\eqannotatelabelgap{3.2pt}
\newcommand\eqannotatecolumnpad{0.45em}
\newcommand\eqannotatetargetgap{2.0pt}
\newcommand\eqannotateroutetrackstep{1.8pt}
\newcommand\eqannotateroutetrackspan{6.4pt}
\newcommand\eqannotatemaxshift{5.0em}
\newcommand\eqannotatebackgroundcolor{white}
% Public API intentionally stops at semantic declarations, soft side hints,
% theme/callout switches, and the manual escape hatch. Geometry knobs above
% remain advanced document-wide tuning parameters rather than per-label input.

\tikzset{
  eqannotate/label/.style={font=\eqannotatefont,align=center,inner xsep=2pt,inner ysep=1.5pt,draw=none,fill=\eqannotatebackgroundcolor},
  eqannotate/leader/.style={line width=.4pt,line cap=round,line join=round},
}

\newcommand*{\eqannotatemathcolorbox}[2]{%
  \mathchoice
    {\colorbox{#1}{$\displaystyle\mathstrut #2$}}%
    {\colorbox{#1}{$\textstyle\mathstrut #2$}}%
    {\colorbox{#1}{$\scriptstyle\mathstrut #2$}}%
    {\colorbox{#1}{$\scriptscriptstyle\mathstrut #2$}}%
}

\makeatletter
\newcommand{\eqannotateauxdef}[2]{%
  \protected@write\@auxout{}{%
    \string\expandafter\string\gdef
    \string\csname\space#1\string\endcsname{#2}}%
}
\makeatother

% amsmath display environments such as multline perform an internal measuring
% pass. Semantic declarations must be inert during that pass; otherwise the
% remembered TikZ node can be captured from the measuring copy rather than the
% final typeset copy.
\makeatletter
\newcommand{\eqaIfAmsmathMeasuringTF}[2]{\ifmeasuring@#1\else#2\fi}
\makeatother

